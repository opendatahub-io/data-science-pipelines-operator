apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ds-pipelines-{{.Name}}
  namespace: {{.Namespace}}
spec:
  podSelector:
    matchLabels:
      app: {{.APIServerDefaultResourceName}}
      component: data-science-pipelines
  policyTypes:
    - Ingress
    - Egress
  ingress:
    {{ if and .APIServer .APIServer.EnableRoute }}
    # Authenticated kube-rbac-proxy. Port-only so any cluster pod and the
    # OpenShift router can reach it. The router commonly uses host networking,
    # so a pod or namespace selector is not portable.
    - ports:
        - protocol: TCP
          port: 8443
    {{ end }}
    {{ if .APIServer }}
    # Prometheus-only kube-rbac-proxy. Restricted to monitoring namespaces.
    - ports:
        - protocol: TCP
          port: 8445
      from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: openshift-monitoring
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: openshift-user-workload-monitoring
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: redhat-ods-monitoring
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: opendatahub-monitoring
    {{ end }}
    # Direct API HTTP. No login check, so only the persistence agent and KFP
    # runtime pods (v2_component, shared by drivers and executors) may connect.
    - ports:
        - protocol: TCP
          port: 8888
      from:
        - podSelector:
            matchLabels:
              app: ds-pipeline-persistenceagent-{{.Name}}
              component: data-science-pipelines
        - podSelector:
            matchLabels:
              pipelines.kubeflow.org/v2_component: "true"
    # Direct API gRPC. Same callers as 8888, plus the scheduled-workflow controller.
    - ports:
        - protocol: TCP
          port: 8887
      from:
        - podSelector:
            matchLabels:
              app: ds-pipeline-persistenceagent-{{.Name}}
              component: data-science-pipelines
        - podSelector:
            matchLabels:
              app: ds-pipeline-scheduledworkflow-{{.Name}}
              component: data-science-pipelines
        - podSelector:
            matchLabels:
              pipelines.kubeflow.org/v2_component: "true"
  egress:
    {{ if .APIServerReplacementEgress }}
{{ .APIServerReplacementEgress }}
    {{ else }}
    # DNS. Port 53 is the Service port and 5353 is the CoreDNS target port.
    - ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
        - protocol: UDP
          port: 5353
        - protocol: TCP
          port: 5353
    # Kubernetes API. 443 is the Service port and 6443 is the apiserver port.
    - ports:
        - protocol: TCP
          port: 443
        - protocol: TCP
          port: 6443
    # MySQL may be external, so the port is allowed to any address.
    - ports:
        - protocol: TCP
          port: {{ .DBConnection.Port }}
    # S3-compatible storage may be external. The built-in MinIO Route uses HTTPS on 443.
    {{ if .ObjectStorageConnection.Port }}
    - ports:
        - protocol: TCP
          port: {{ .ObjectStorageConnection.Port }}
    {{ else if eq .ObjectStorageConnection.Scheme "https" }}
    - ports:
        - protocol: TCP
          port: 443
    {{ else }}
    - ports:
        - protocol: TCP
          port: 80
    {{ end }}
    - ports:
        - protocol: TCP
          port: {{ .MLMD.GRPC.Port }}
      to:
        - podSelector:
            matchLabels:
              app: ds-pipeline-metadata-grpc-{{ .Name }}
              component: data-science-pipelines
    {{ range .ProxyEgressPorts }}
    - ports:
        - protocol: TCP
          port: {{ . }}
    {{ end }}
    {{ if .MLflowEgressPort }}
    - ports:
        - protocol: TCP
          port: {{ .MLflowEgressPort }}
    {{ end }}
    {{ end }}
    {{ if .APIServerAdditionalEgress }}
{{ .APIServerAdditionalEgress }}
    {{ end }}
