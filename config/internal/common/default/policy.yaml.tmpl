apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ds-pipelines-{{.Name}}
  namespace: {{.Namespace}}
spec:
  podSelector:
    matchLabels:
      app: {{.APIServerDefaultResourceName}}
      component: data-science-pipelines
  policyTypes:
    - Ingress
  ingress:
    {{ if and .APIServer .APIServer.EnableRoute }}
    # Authenticated kube-rbac-proxy. Port-only so any cluster pod and the
    # OpenShift router can reach it. The router commonly uses host networking,
    # so a pod or namespace selector is not portable.
    - ports:
        - protocol: TCP
          port: 8443
    {{ end }}
    # Direct API HTTP. No login check, so only the persistence agent and the
    # KFP runtime roles may connect.
    - ports:
        - protocol: TCP
          port: 8888
      from:
        - podSelector:
            matchLabels:
              app: ds-pipeline-persistenceagent-{{.Name}}
              component: data-science-pipelines
        - podSelector:
            matchLabels:
              pipelines.kubeflow.org/pod-role: container-driver
        - podSelector:
            matchLabels:
              pipelines.kubeflow.org/pod-role: dag-driver
        - podSelector:
            matchLabels:
              pipelines.kubeflow.org/pod-role: container-executor
        - podSelector:
            matchLabels:
              pipelines.kubeflow.org/pod-role: importer
    # Direct API gRPC. Same callers as 8888, plus the scheduled-workflow controller.
    - ports:
        - protocol: TCP
          port: 8887
      from:
        - podSelector:
            matchLabels:
              app: ds-pipeline-persistenceagent-{{.Name}}
              component: data-science-pipelines
        - podSelector:
            matchLabels:
              app: ds-pipeline-scheduledworkflow-{{.Name}}
              component: data-science-pipelines
        - podSelector:
            matchLabels:
              pipelines.kubeflow.org/pod-role: container-driver
        - podSelector:
            matchLabels:
              pipelines.kubeflow.org/pod-role: dag-driver
        - podSelector:
            matchLabels:
              pipelines.kubeflow.org/pod-role: container-executor
        - podSelector:
            matchLabels:
              pipelines.kubeflow.org/pod-role: importer
