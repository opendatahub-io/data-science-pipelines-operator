kind: NetworkPolicy
apiVersion: networking.k8s.io/v1
metadata:
  name: ds-pipeline-drivers-{{.Name}}
  namespace: {{.Namespace}}
spec:
  podSelector:
    matchExpressions:
      - key: pipelines.kubeflow.org/pod-role
        operator: In
        values:
          - container-driver
          - dag-driver
  policyTypes:
    - Ingress
